#!/bin/sh
# Guard (spec: Guards, grill D17): a commit may not silently change results.
# Runs the fast weekend tests, incl. the golden replay (committed Singapore record -> byte-identical lap).
# Active via: git config core.hooksPath weekend/hooks
cd "$(git rev-parse --show-toplevel)" || exit 1
python -m pytest -q -m "not slow" tests/test_weekend_pack.py tests/test_weekend_system.py || {
  echo "pre-commit: weekend tests failed (golden replay or pack checks) - commit blocked" >&2; exit 1; }
