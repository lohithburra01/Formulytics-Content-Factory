# Videos: heavy, regenerated by the pipeline (kept out of the sandbox entirely)
*.mp4
*.mov
*.mkv
*.avi
*.webm

# Python auto-generated caches
__pycache__/
.pytest_cache/
*.pyc

# Large downloaded / re-fetchable caches
cache/fastf1_http_cache.sqlite
cache/ext/saxena_zip/*.zip

# Third-party cloned repo (has its own .git)
cache/ext/kadiri/

# pipeline run folders (re-creatable from the committed packs)
runs/
weekend/.search_cache/
